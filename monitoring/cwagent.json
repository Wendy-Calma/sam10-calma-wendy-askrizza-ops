{
  "agent": { "metrics_collection_interval": 60, "run_as_user": "root" },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/"],
        "ignore_file_system_types": ["sysfs", "devtmpfs", "tmpfs", "overlay", "squashfs"]
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/app/LibreChat/logs/caddy/access.log",
            "log_group_name": "/sam10/caddy",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 14
          },
          {
            "file_path": "/opt/app/LibreChat/logs/error-*.log",
            "log_group_name": "/sam10/app",
            "log_stream_name": "{instance_id}-error",
            "retention_in_days": 14
          },
          {
            "file_path": "/opt/app/LibreChat/logs/debug-*.log",
            "log_group_name": "/sam10/app",
            "log_stream_name": "{instance_id}-debug",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/sam10/automation.log",
            "log_group_name": "/sam10/automation",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30
          }
        ]
      }
    }
  }
}
