# AskRizza deployment settings (non-secret). Secrets: SSM /sam10/*

AWS_REGION=us-east-1
PROJECT=SAM10

# content/ and backups/
BUCKET=sam10-askrizza-data-2026

# DuckDNS -> Elastic IP
SITE_DOMAIN=askrizza.duckdns.org

# Branding
APP_TITLE=AskRizza
APP_VERSION=v1.0.0

ALLOW_REGISTRATION=false

# OpenAI-compatible model API. Key: SSM /sam10/LLM_API_KEY
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# Groq:   https://api.groq.com/openai/v1/
# Models: https://ai.google.dev/gemini-api/docs/models
LLM_PROVIDER="Google Gemini"
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_TITLE_MODEL=gemini-3.5-flash-lite

# Account ID is resolved at runtime when left as CHANGE_ME
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:CHANGE_ME_ACCOUNT_ID:sam10-alerts
